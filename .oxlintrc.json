{
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "react/rules-of-hooks": "error",
    "react/refs": "off",
    "react/purity": "off",
    "react/globals": "off",
    "react/set-state-in-effect": "off",
    "react/static-components": "off"
  },
  "overrides": [
    {
      "files": [
        "tests/**"
      ],
      "rules": {
        "react/no-children-prop": "off"
      }
    }
  ]
}
